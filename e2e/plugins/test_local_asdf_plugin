#!/usr/bin/env bash

# Create a minimal ASDF plugin locally
# Plugin directory: demo-asdf-plugin
# Plugin name: demo
# Tool provided: demo (binary: demo-tool)
mkdir -p demo-asdf-plugin/bin
cat >demo-asdf-plugin/bin/list-all <<'EOF'
#!/usr/bin/env bash
echo "1.0.0 2.0.0 3.0.0"
EOF
chmod +x demo-asdf-plugin/bin/list-all

cat >demo-asdf-plugin/bin/install <<'EOF'
#!/usr/bin/env bash
echo "Installing version $ASDF_INSTALL_VERSION"
mkdir -p "$ASDF_INSTALL_PATH/bin"
cat > "$ASDF_INSTALL_PATH/bin/demo-tool" <<TOOL
#!/usr/bin/env bash
echo "demo-tool version $ASDF_INSTALL_VERSION"
TOOL
chmod +x "$ASDF_INSTALL_PATH/bin/demo-tool"
EOF
chmod +x demo-asdf-plugin/bin/install

# Configure mise to use local plugin
# Register plugin "demo" from local directory
cat >mise.toml <<EOF
[plugins]
demo = "./demo-asdf-plugin"

[tools]
demo = "2.0.0"
EOF

# Test: plugin appears in plugin ls
assert_contains "mise plugin ls" "demo"

# Test: can list versions from local plugin
assert_contains "mise ls-remote demo" "2.0.0"

# Test: can install tool from local plugin
mise install demo@2.0.0
assert_contains "mise ls --installed" "demo"

# Test: can execute tool
assert_contains "mise x -- demo-tool" "demo-tool version 2.0.0"

# Cleanup
rm -rf demo-asdf-plugin
